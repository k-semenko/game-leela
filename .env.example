# Game Leela — local monorepo
COMPOSE_PROJECT_NAME=game-leela
NODE_ENV=LOCAL
LOG_LEVEL=debug

# Ports
APP_PORT=3001
WS_PORT=3002
TG_PORT=4000
FRONT_PORT=4200

# Postgres
# Inside compose, services override POSTGRES_HOST=postgres.
# For host-side npm (make seed / npm start:bff) use localhost.
POSTGRES_HOST=postgres
POSTGRES_USER=leela
POSTGRES_PASSWORD=leela
POSTGRES_DB=leela
POSTGRES_PORT=5432

# Auth / origins
JWT_SECRET=change-me-local-only
ORIGIN=http://localhost:4200/
WS_ORIGIN=http://localhost:4200/
# BFF → bot (Docker network). For host-only bot use http://localhost:4000/tg
TG_ORIGIN=http://bot:4000/tg

# Mail (optional locally)
MAIL_HOST=smtp.example.com
MAIL_PORT=2525
MAIL_USER=example@example.ru
MAIL_PASS=example
MAIL_SECURE=false

# Payments (placeholders)
YOOMONEY=example:example
YOOMONEY_API=https://api.yookassa.ru/v3
RESET_PASS_EXPIRATION=30

# Telegram bot (placeholder OK — bot container may restart without a real token)
TG_BOT_TOKEN=123456:replace-me
TG_PROJECT_GROUP_ID=-1000000000000
TG_ADMINS=[0]

# Docker build targets (compose defaults to run if unset)
# Primary stack: docker compose up --build -d
# Hot reload:    docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
TARGET_BFF=run
TARGET_BOT=run
TARGET_FRONT=run
ENV=docker

# Auto-seed demo fields/cells/tariffs/users when BFF starts (set false to disable)
SEED_ON_BOOT=true
DEMO_PASS=demo1234

# Set true behind HTTPS; local http docker leaves cookies without Secure
COOKIE_SECURE=false
